{
  "manifest_version": 3,
  "name": "Odak Bekçisi",
  "version": "1.1.0",
  "description": "Sitelerde harcadığın zamanı takip eder, dikkat dağıtan sitelere günlük süre limiti koymana yardımcı olur.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Odak Bekçisi"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["storage", "tabs", "alarms", "idle", "notifications"]
}
